{
  "name": "lovelace-ua-outages-card",
  "version": "0.1.0",
  "description": "Custom Home Assistant Lovelace cards for Ukrainian power outage schedules",
  "license": "MIT",
  "author": "Rachenko Oleksii <alexey.rachenko@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/shed-crypto/lovelace-ua-outages-card.git"
  },
  "type": "module",
  "main": "dist/ua-outages-card.js",
  "files": [
    "dist/ua-outages-card.js"
  ],
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" *.json *.mjs",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-lit": "^2.3.1",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "rollup": "^4.68.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
